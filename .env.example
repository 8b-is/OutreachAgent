# --- Provider keys (set ONE) ---
# OpenRouter (recommended default — single key, many models)
OPENROUTER_API_KEY=sk-or-v1-...

# Or OpenAI
# OPENAI_API_KEY=sk-...

# Or Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Or Google
# GOOGLE_API_KEY=...

# --- Model selection ---
# Must match the provider above. LiteLLM-style model strings.
AI_MODEL=openrouter/google/gemini-2.5-flash
# AI_MODEL=gpt-4o
# AI_MODEL=anthropic/claude-3-5-sonnet-20241022
# AI_MODEL=gemini/gemini-1.5-pro

# --- Optional overrides ---
AGENT_NODE_ID=linkedin-outreach-agent
AGENT_NODE_PORT=8001
AGENTFIELD_HTTP_PORT=18080

# --- CloakBrowser & WhatsApp Proof Bridge ---
# OUTREACH_CHROME_PROFILE_DIR=~/Library/Application Support/Google/Chrome/Default
# OUTREACH_CLOAK_PROFILE_DIR=~/.config/8b-linkedin-outreach/cloak-profile-v145
# OUTREACH_ACCOUNT_LABEL=8b-is Operator (via CloakBrowser)
# OUTREACH_WA_JID=120363413133092554@g.us
